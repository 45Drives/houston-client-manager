{
  "name": "45drives-setup-wizard",
  "version": "1.6.4",
  "description": "Create backups to any houston servers on your local network",
  "main": "main/src/main/main.js",
  "workspaces": [
    "houston-common/houston-common-*"
  ],
  "scripts": {
    "dev": "yarn build:common && yarn build:easysetup && node scripts/dev-server.js",
    "build": "yarn build:common && yarn build:easysetup && node scripts/build.js && electron-builder",
    "build:common": "yarn build:lib && yarn build:ui",
    "build:easysetup": "node scripts/bundle-easysetup.mjs",
    "build:win": "yarn build:common && node scripts/build.js && yarn test && electron-builder --win --config electron-builder.json",
    "build:mac": "yarn build:common && node scripts/build.js && yarn test && electron-builder --mac",
    "build:linux": "yarn build:common && node scripts/build.js && yarn test && electron-builder --linux",
    "release": "bash scripts/release/release.sh",
    "release:patch": "bash scripts/release/release.sh --bump patch --os all",
    "release:minor": "bash scripts/release/release.sh --bump minor --os all",
    "release:major": "bash scripts/release/release.sh --bump major --os all",
    "release:quick": "bash scripts/release/release.sh --os all",
    "release:linux": "bash scripts/release/release.sh --os linux",
    "release:mac": "bash scripts/release/release.sh --os mac",
    "release:windows": "bash scripts/release/release.sh --os windows",
    "release:windows:stage": "bash scripts/release/release.sh --os windows --stage",
    "release:windows:finalize": "bash scripts/release/release.sh --os windows --finalize",
    "release:gen-yml": "node scripts/release/generate-update-yml.mjs",
    "release:publish-from-builds": "bash scripts/release/publish-from-builds.sh",
    "release:orchestrate": "bash scripts/release/orchestrate-release.sh",
    "mac:dir:arm64": "yarn build:common && node scripts/build.js && CSC_IDENTITY_AUTO_DISCOVERY=false SKIP_AFTER_SIGN=1 electron-builder --mac --arm64 --dir",
    "mac:dir:x64": "yarn build:common && node scripts/build.js && CSC_IDENTITY_AUTO_DISCOVERY=false SKIP_AFTER_SIGN=1 electron-builder --mac --x64 --dir",
    "mac:dir:universal": "yarn build:common && node scripts/build.js && CSC_IDENTITY_AUTO_DISCOVERY=false SKIP_AFTER_SIGN=1 electron-builder --mac --universal --dir",
    "test": "vitest run",
    "test:int": "vitest run --exclude '**/node_modules/**' '**/*.int.test.ts'"
  },
  "repository": "https://github.com/45Drives/houston-client-manager",
  "author": {
    "name": "Matt Pyne",
    "email": "mpyne@45drives.com"
  },
  "devDependencies": {
    "@fontsource/red-hat-text": "^5.0.18",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/forms": "^0.5.7",
    "@types/ssh2": "^1.15.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.19",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.6",
    "electron-osx-sign": "^0.6.0",
    "esbuild": "^0.25.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.38",
    "postcss-modules": "^6.0.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^6.0.11",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@45drives/houston-common-css": "workspace:*",
    "@45drives/houston-common-lib": "workspace:*",
    "@45drives/houston-common-ui": "workspace:*",
    "asar": "^3.2.0",
    "electron-log": "^5.4.1",
    "electron-updater": "6.6.2",
    "multicast-dns": "^7.2.5",
    "node-localstorage": "^3.0.5",
    "node-ssh": "^13.2.1",
    "plist": "^3.1.0",
    "ssh2": "^1.16.0",
    "sudo-prompt": "^9.2.1",
    "vue": "^3.3.8",
    "vue-router": "^4.5.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.9"
  },
  "packageManager": "yarn@4.6.0+sha512.5383cc12567a95f1d668fbe762dfe0075c595b4bfff433be478dbbe24e05251a8e8c3eb992a986667c1d53b6c3a9c85b8398c35a960587fbd9fa3a0915406728"
}
