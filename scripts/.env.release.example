# App / paths
APP_PRODUCT_FILENAME="45Drives-Storage-Wizard"
ENTITLEMENTS_FILE="entitlements.mac.plist"
CODESIGN_IDENTITY='Developer ID Application: Protocase Incorporated (xxx)'
# Leave unset/empty to skip building the .pkg installer.
INSTALLER_IDENTITY='Developer ID Installer: Protocase Incorporated (xxx)'
NOTARY_PROFILE="AC_NOTARY"
SIGN_INBOX="/Users/username/houston-client-manager/"
SIGN_OUTPUT_DIR="/Users/username/houston-client-manager/mac-signing-out"

# Build mode: arm64 | x64 | universal
MAC_BUILD_KIND="universal"

# Signing machine SSH
SIGN_HOST="x.x.x.x"
SIGN_USER="useername"
SIGN_GIT_PULL_CMD="cd '/Users/username/houston-client-manager' && git pull --ff-only --tags --force"
SIGN_KEYCHAIN="/keychain/path"
SIGN_KEYCHAIN_PASSWORD="xxxxxx"

# Sync signed artifacts from Intel signer back to this (ARM build) host.
SYNC_SIGNED_BACK_TO_ARM=1
ARM_SIGNED_OUTPUT_DIR="/Users/username/houston-client-manager/Mac-signed/__BUNDLE_TAG__/"
