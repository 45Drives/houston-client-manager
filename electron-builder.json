{
    "appId": "com.protocase.drivestoragewizard",
    "directories": {
        "output": "dist",
        "buildResources": "assets/icons"
    },
    "productName": "45Drives-Storage-Wizard",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "publish": {
        "provider": "github",
        "owner": "45Drives",
        "repo": "houston-client-manager"
    },
    "afterSign": "scripts/afterSign-verify.js",
    "afterPack": "scripts/afterPack-fix-native.js",
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "shortcutName": "45Drives Storage Wizard"
    },
    "mac": {
        "icon": "mac/icon.icns",
        "target": [
            "dmg",
            "zip"
        ],
        "hardenedRuntime": true,
        "entitlements": "entitlements.mac.plist",
        "entitlementsInherit": "entitlements.mac.inherit.plist",
        "x64ArchFiles": "**/static/mac/houston-backupd",
        "extendInfo": {
            "NSLocalNetworkUsageDescription": "45Drives Storage Wizard finds and configures 45Drives servers on your local network.",
            "NSDesktopFolderUsageDescription": "45Drives Storage Wizard needs access to your Desktop to back it up.",
            "NSDocumentsFolderUsageDescription": "45Drives Storage Wizard needs access to your Documents to back them up.",
            "NSDownloadsFolderUsageDescription": "45Drives Storage Wizard needs access to your Downloads to back them up.",
            "NSRemovableVolumesUsageDescription": "45Drives Storage Wizard needs access to removable volumes to back them up.",
            "NSBonjourServices": [
                "_houstonserver._tcp"
            ]
        },
        "signIgnore": [
            ".*\\.(png|jpe?g|svg|gif|webp|ico|icns)$",
            ".*\\.(mp3|wav|aac|mp4|mov|webm|ogg)$",
            ".*\\.(json|txt|md|html|css|map)$",
            ".*\\.pak$",
            ".*/[A-Za-z_]+\\.lproj/.*$",
            ".*/Electron Framework\\.framework/Versions/A/Resources/.*$",
            ".*/assets/.*"
        ]
    },
    "pkg": {
        "scripts": "assets/mac/pkg-scripts",
        "installLocation": "/Applications",
        "isRelocatable": false,
        "isVersionChecked": false,
        "overwriteAction": "upgrade"
    },
    "win": {
        "target": "nsis",
        "compression": "maximum",
        "icon": "win/icon.ico",
        "signAndEditExecutable": true
    },
    "linux": {
        "target": [
            "deb",
            "rpm",
            "pacman"
        ],
        "category": "Utility",
        "vendor": "45Drives",
        "maintainer": "Matt Pyne <mpyne@45drives.com>",
        "icon": "linux"
    },
    "deb": {
        "afterInstall": "assets/linux/after-install.tpl",
        "depends": [
            "libgtk-3-0",
            "libnotify4",
            "libnss3",
            "libxss1",
            "libxtst6",
            "xdg-utils",
            "libatspi2.0-0",
            "libuuid1",
            "libsecret-1-0",
            "smbclient",
            "cifs-utils",
            "rsync",
            "cron"
        ]
    },
    "rpm": {
        "afterInstall": "assets/linux/after-install.tpl",
        "depends": [
            "gtk3",
            "libnotify",
            "nss",
            "libXScrnSaver",
            "(libXtst or libXtst6)",
            "xdg-utils",
            "at-spi2-core",
            "(libuuid or libuuid1)",
            "samba-client",
            "cifs-utils",
            "rsync",
            "cronie"
        ]
    },
    "pacman": {
        "afterInstall": "assets/linux/after-install.tpl"
    },
    "files": [
        {
            "from": "node_modules/@45drives",
            "to": "node_modules/@45drives",
            "filter": [
                "**/*",
                "!**/*.map",
                "!**/*.blend",
                "!houston-common-ui/lib/**",
                "!houston-common-ui/node_modules/**",
                "!houston-common-ui/scripts/**",
                "!houston-common-ui/typings/**",
                "!houston-common-lib/lib/**",
                "!houston-common-lib/node_modules/**",
                "!houston-common-lib/examples/**",
                "!houston-common-lib/scripts/**",
                "!houston-common-lib/tests/**",
                "!houston-common-lib/typings/**"
            ]
        },
        {
            "from": "build/main",
            "to": "main",
            "filter": [
                "**/*"
            ]
        },
        {
            "from": "build/renderer",
            "to": "renderer",
            "filter": [
                "**/*"
            ]
        },
        {
            "from": "src/main/static",
            "to": "static",
            "filter": [
                "**/*"
            ]
        },
        "!src",
        "!build",
        "!builds",
        "!dist",
        "!scripts",
        "!houston-common",
        "!.electron-dev-userdata",
        "!.electron-dev-userdata/**",
        "!**/*.test.js",
        "!**/*.test.ts",
        "!**/*.md",
        "!**/*.config.js",
        "!**/*.config.ts",
        "!**/*.config.cjs",
        "!**/package-lock.json",
        "!**/.git*",
        "!**/__tests__/**",
        "!**/*.map",
        "!**/MakeFile",
        "!**/node_modules/cpu-features/**",
        "!**/node_modules/buildcheck/**",
        "!**/.yarn/**",
        "!**/node_modules/*/test/**",
        "!**/node_modules/*/.git/**",
        "!**/node_modules/@rollup/**",
        "!**/node_modules/rollup/**",
        "!**/node_modules/webpack/**",
        "!**/node_modules/esbuild/**",
        "!**/node_modules/@esbuild/**",
        "!**/node_modules/vite/**",
        "!**/node_modules/@vitejs/**",
        "!**/@esbuild/**",
        "!**/esbuild-*/**",
        "!**/node_modules/@vue/**",
        "!**/node_modules/typescript/**",
        "!**/node_modules/vue/**",
        "!**/node_modules/@types/**",
        "!**/node_modules/@45drives/houston-common-ui/node_modules/**",
        "!**/node_modules/@45drives/houston-common-ui/lib/**",
        "!**/node_modules/@45drives/houston-common-ui/scripts/**",
        "!**/node_modules/@45drives/houston-common-ui/typings/**",
        "!**/node_modules/@45drives/houston-common-lib/node_modules/**",
        "!**/node_modules/@45drives/houston-common-lib/lib/**",
        "!**/node_modules/@45drives/houston-common-lib/examples/**",
        "!**/node_modules/@45drives/houston-common-lib/scripts/**",
        "!**/node_modules/@45drives/houston-common-lib/tests/**",
        "!**/node_modules/@45drives/houston-common-lib/typings/**",
        "!**/node_modules/@45drives/houston-common-ui/lib/components/ServerView/assets/**",
        "!**/node_modules/@45drives/houston-common-ui/lib/components/img/**",
        "!Mac-signed",
        "!Mac-signed/**",
        "!mac-signing-out",
        "!mac-signing-out/**"
    ],
    "extraResources": [
        {
            "from": "src/main/static",
            "to": "static",
            "filter": [
                "**/*"
            ]
        }
    ],
    "asar": true,
    "asarUnpack": ["**/*.node", "**/*.dylib"]
}
