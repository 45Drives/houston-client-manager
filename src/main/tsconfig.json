{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../../build/main",
    // Pinned to the repo root because the main process also compiles src/shared and
    // houston-common. Left inferred, adding or dropping one of those imports shifts the
    // common source directory and silently moves main.js away from package.json "main".
    "rootDir": "../..",
    "allowJs": true,
    "noImplicitAny": false,
  },
  "exclude": [
    "static",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.int.test.ts",
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**"
  ]
}
